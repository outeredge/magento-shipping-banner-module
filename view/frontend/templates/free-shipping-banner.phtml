<?php
/* @var $block Magento\Framework\View\Element\Template */
/* @var $messageViewModel \OuterEdge\FreeShippingPromo\ViewModel\Message */

$messageViewModel = $block->getData('message_view_model');
$jsRoute = $block->getData('jsRoute');
$uniqueId = uniqid('free-shipping-banner-');
$config = json_decode($messageViewModel->getConfig(), true) ?: [];
$additionalConfig = $block->getData('additional_config') ?: [];
$bannerConfig = array_replace($config, (array) $additionalConfig);
$cssClass = $block->getData('additional_css_class') ?: '';
$isHidden = (bool) $block->getData('is_hidden');
?>
<?php if ($messageViewModel->getIsEnabled()): ?>
    <div id="<?= $block->escapeHtmlAttr($uniqueId) ?>" class="free-shipping-banner <?= $block->escapeHtmlAttr($cssClass) ?>" data-bind="scope: '<?= $block->escapeHtmlAttr($uniqueId) ?>-component'"<?php if ($isHidden): ?> style="display: none;"<?php endif; ?>>
        <!--ko template: getTemplate() -->
            <span><?= $messageViewModel->getDefaultMessage() ?></span>
        <!-- /ko -->
    </div>
    <script type="text/x-magento-init">
         {
            "#<?= $block->escapeJs($uniqueId) ?>": {
                "Magento_Ui/js/core/app": {
                    "components": {
                        "<?= $block->escapeJs($uniqueId) ?>-component": {
                            "component": "<?= $block->escapeJs($jsRoute) ?>",
                            "config": <?= json_encode($bannerConfig, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>
                        }
                    }
                }
            }
        }
    </script>
<?php endif; ?>
